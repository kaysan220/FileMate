    "SPOOFING": [
        {
            "id": "spoof_hrd_01",
            "type": "SPOOFING",
            "title": "Lampiran Email Mendesak dari HRD Magang",
            "story": "Kamu menerima email yang mengaku dari HRD tempat magang, meminta segera menandatangani kontrak kerja dan memeriksa foto denah ruangan. Gunakan X-Ray sebelum memutuskan membuka atau menghapus file!",
            "path": "~/Downloads/Email_HRD_Magang/",
            "officialHash": null,
            "hintAuthor": "Muhammad Fardan (Project Leader & DKS)",
            "hintText": "Jangan hanya melihat nama akhir file! Periksa baris 'Header / Magic Bytes' dan 'Pemindaian Payload' di X-Ray. File .jpg atau .pdf sekalipun berbahaya jika berisi program Executable (MZ)!",
            "goodEnding": "🎬 <strong>Ending Skenario Ini (Keputusan Tepat!):</strong> Kamu berhasil menghapus file jebakan tersebut dan melapor ke tim IT. Ternyata email itu berasal dari sindikat phishing yang mengincar mahasiswa magang. Laptop dan akunmu 100% selamat!",
            "badEnding": "🎬 <strong>Ending Skenario Ini (Insiden Terjadi!):</strong><br>• <strong>Detik ke-03:</strong> Program <em>infostealer</em> berjalan diam-diam saat kamu membuka file.<br>• <strong>Menit ke-15:</strong> <em>Session cookies</em> browser dan password tersimpanmu dicuri.<br>• <strong>Hari berikutnya:</strong> Akun email kampusmu diambil alih untuk menyebarkan jebakan serupa ke teman sekelas!",
            "lessonTitle": "Mengapa Ekstensi Ganda & Manipulasi Header (.jpg) Sangat Berbahaya?",
            "lessonBody": "Selain menyembunyikan <code>.exe</code> di belakang <code>.pdf</code>, penyerang juga sering memalsukan ekstensi menjadi <code>.jpg</code> padahal struktur biner di dalamnya (<em>Magic Bytes</em>) adalah program eksekusi atau mengandung <em>script payload</em>.",
            "realLifeTip": "Di Windows, centang 'File name extensions' pada tab View. Di Linux, jalankan perintah <code>file --mime-type namafile</code> untuk melihat tipe biner aslinya.",
