    "HASH": [
        {
            "id": "hash_forum_01",
            "type": "HASH",
            "title": "Verifikasi Installer Patch dari Forum Pihak Ketiga",
            "story": "Kamu mengunduh Patch_Update_v2.zip beserta gambar tutorialnya dari sebuah forum karena server utama sedang penuh. Developer aslinya mencantumkan kode SHA-256 resmi di bawah ini untuk Patch_Update_v2.zip. Periksa keasliannya!",
            "path": "~/Downloads/Forum_Installer/",
            "officialHash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "hintAuthor": "Kaysan Nawfal (Backend & Scoring Logic)",
            "hintText": "Klik '#️⃣ Cek SHA-256' pada Patch_Update_v2.zip lalu klik 'Bandingkan Otomatis'. Jika ada karakter merah (Mismatch), berarti file sudah disisipi trojan dan wajib dihapus!",
            "goodEnding": "🎬 <strong>Ending Skenario Ini (Keputusan Tepat!):</strong> Berkat pemeriksaan SHA-256, kamu mendeteksi bahwa installer di forum tersebut telah dimodifikasi pihak ketiga. Kamu membatalkan instalasi dan mengunduh ulang dari situs resmi dengan aman!",
            "badEnding": "🎬 <strong>Ending Skenario Ini (Insiden Terjadi!):</strong><br>• Kamu mengabaikan ketidakcocokan kode hash dan tetap menjalankan installer.<br>• Celah <em>Remote Access Trojan (RAT)</em> terbuka di laptopmu sehingga hacker dapat memantau aktivitas sistemmu dari jarak jauh!",
            "lessonTitle": "Prinsip Integrity (CIA Triad) Melalui Verifikasi SHA-256",
            "lessonBody": "Nama dan ukuran file yang tampak sama tidak menjamin keaslian isinya. Perubahan 1 bit saja akibat penyisipan malware akan mengubah kode SHA-256 secara keseluruhan.",
            "realLifeTip": "Selalu jalankan <code>sha256sum</code> di Linux atau <code>Get-FileHash</code> di PowerShell sebelum menginstal software dari internet.",
